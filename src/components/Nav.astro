---
import Logo from './Logo.astro';
const liens = [
  { href: '/mes-creations', label: 'Mes créations' },
  { href: '/personnaliser', label: 'Personnaliser' },
  { href: '/editions-speciales', label: 'Éditions spéciales' },
  { href: '/atelier', label: "L'atelier" },
];
---

<header class="nav">
  <div class="contenu nav__inner">
    <a class="marque" href="/" aria-label="Atelier Acidulé — accueil">
      <Logo size={52} />
      <span class="marque__nom">Atelier Acidulé</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle" hidden />
    <label for="nav-toggle" class="nav__burger" aria-label="Ouvrir ou fermer le menu">
      <span></span><span></span><span></span>
    </label>

    <!-- Overlay mobile -->
    <div class="nav__overlay" aria-hidden="true"></div>

    <nav class="nav__liens" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn btn--citron nav__cta" href="/personnaliser">SHOP TON SAC !</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sapin);
    border-bottom: 1px solid color-mix(in srgb, var(--citron-clair) 18%, transparent);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }
  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--citron-clair);
  }
  .marque__nom {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
  }
  .nav__liens {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .nav__liens a:not(.btn) {
    color: color-mix(in srgb, var(--creme) 85%, transparent);
    font-weight: 600;
    font-size: 0.98rem;
  }
  .nav__liens a:not(.btn):hover {
    color: var(--citron-clair);
  }
  .nav__cta {
    padding: 0.6rem 1.25rem;
    font-size: 0.98rem;
  }

  /* ---- Overlay mobile ---- */
  .nav__overlay {
    display: none;
    position: fixed;
    inset: 0;
    top: 76px;
    background: rgba(47, 67, 52, 0.35);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 350ms ease;
    pointer-events: none;
    z-index: 40;
  }

  /* ---- Burger animate ---- */
  .nav__burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    padding: 8px;
    z-index: 60;
    position: relative;
  }
  .nav__burger span {
    display: block;
    width: 28px;
    height: 2.5px;
    background: var(--citron-clair);
    border-radius: 3px;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
                opacity 200ms ease;
    transform-origin: center;
  }

  @media (max-width: 860px) {
    .nav__burger { display: flex; }
    .nav__overlay { display: block; }

    .nav__liens {
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      padding: 0.8rem var(--gouttiere) 1.8rem;
      background: color-mix(in srgb, var(--creme) 96%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid color-mix(in srgb, var(--sauge) 25%, transparent);
      box-shadow: 0 16px 32px -16px rgba(47, 67, 52, 0.25);
      transform: translateY(-16px);
      opacity: 0;
      transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 300ms ease;
      pointer-events: none;
      z-index: 45;
    }
    .nav__liens a:not(.btn) {
      padding: 0.75rem 0.8rem;
      font-size: 1.1rem;
      border-radius: 12px;
      transition: background 200ms ease, color 200ms ease;
    }
    .nav__liens a:not(.btn):hover {
      background: color-mix(in srgb, var(--sauge) 15%, transparent);
      color: var(--sapin);
    }
    .nav__cta {
      margin-top: 0.6rem;
      justify-content: center;
      padding: 0.85rem 1.25rem;
      font-size: 1.05rem;
    }

    /* ---- Ouvert ---- */
    .nav__toggle:checked ~ .nav__liens {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .nav__toggle:checked ~ .nav__overlay {
      opacity: 1;
      pointer-events: auto;
    }

    /* Burger → X */
    .nav__toggle:checked ~ .nav__burger span:nth-child(1) {
      transform: translateY(8.5px) rotate(45deg);
    }
    .nav__toggle:checked ~ .nav__burger span:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    .nav__toggle:checked ~ .nav__burger span:nth-child(3) {
      transform: translateY(-8.5px) rotate(-45deg);
    }
  }

  /* ── Petit mobile ── */
  @media (max-width: 400px) {
    .nav__inner { min-height: 64px; }
    .marque__nom { font-size: 1.2rem; }
    .marque img { width: 40px; height: 40px; }
    .nav__liens { top: 64px; }
    .nav__overlay { top: 64px; }
  }
</style>
