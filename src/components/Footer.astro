---
import Logo from './Logo.astro';
const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="contenu pied__inner">
    <div class="pied__marque">
      <Logo size={64} variant="fonce" />
      <div>
        <p class="pied__nom">Atelier Acidulé</p>
        <p class="pied__bio">
          Des créations qui ne manquent pas de piquant 🍋‍🟩<br />
          Sacs au crochet · Personnalisation sur demande
        </p>
      </div>
    </div>

    <div class="pied__liens">
      <a
        class="btn btn--ghost"
        href="https://www.instagram.com/atelier_acidule"
        target="_blank"
        rel="noopener noreferrer"
      >
        @atelier_acidule
      </a>
      <p class="pied__note">
        Une question, une commande spéciale ? Écris-nous en DM Instagram.
      </p>
    </div>
  </div>
  <p class="pied__copy">© {annee} Atelier Acidulé · fait main avec amour en France</p>
</footer>

<style>
  .pied {
    background: var(--sapin);
    color: color-mix(in srgb, var(--creme) 92%, transparent);
    margin-top: 2rem;
  }
  .pied__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 3rem 1.5rem;
  }
  .pied__marque {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .pied__nom {
    font-family: var(--font-wordmark);
    font-weight: 700;
    font-size: 1.4rem;
    margin: 0;
    color: var(--citron-clair);
  }
  .pied__bio {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .pied__liens {
    text-align: right;
  }
  .pied__liens .btn--ghost {
    color: var(--citron-clair);
    border-color: var(--citron-clair);
  }
  .pied__liens .btn--ghost:hover {
    background: var(--citron);
    color: var(--sapin);
  }
  .pied__note {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .pied__copy {
    text-align: center;
    font-size: 0.8rem;
    opacity: 0.6;
    padding-bottom: 1.5rem;
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--creme) 18%, transparent);
    padding-top: 1.2rem;
  }
  @media (max-width: 640px) {
    .pied__inner { flex-direction: column; text-align: center; gap: 1.2rem; }
    .pied__marque { flex-direction: column; }
    .pied__liens { text-align: center; }
    .pied__bio { font-size: 0.9rem; }
  }
</style>
