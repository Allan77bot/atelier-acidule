---
// Logo Atelier Acidulé dans un cadre CIRCULAIRE.
// Tout le site passe par ce composant : remplacer public/images/logo.png
// (même chemin) suffit à mettre le logo à jour partout.
interface Props {
  size?: number;
  variant?: 'clair' | 'fonce';
  class?: string;
}
const { size = 48, variant = 'clair', class: cls = '' } = Astro.props;
---

<span class:list={['logo-rond', `logo-rond--${variant}`, cls]} style={`--taille:${size}px`}>
  <img src="/images/logo.png" alt="" width={size} height={size} loading="eager" />
</span>

<style>
  .logo-rond {
    display: inline-grid;
    place-items: center;
    width: var(--taille);
    height: var(--taille);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }
  .logo-rond img {
    width: 76%;
    height: 76%;
    object-fit: contain;
  }
  .logo-rond--clair {
    background: var(--creme);
    border: 2px solid color-mix(in srgb, var(--sauge) 65%, transparent);
    box-shadow: var(--ombre-douce);
  }
  .logo-rond--fonce {
    background: color-mix(in srgb, var(--creme) 96%, transparent);
    border: 2px solid var(--citron);
  }
</style>
