---
// Catalogue photo — la galerie complète des créations, alimentée par les
// 223 photos du Drive de la cliente (src/data/catalogue.ts).
// On n'expose ici que les catégories « produit » : la réserve, les visuels de
// la page d'accueil et les logos servent ailleurs et n'ont rien à faire ici.
import PageVoeu from '../layouts/PageVoeu.astro';
import { catalogue } from '../data/catalogue';
import { familleDe } from '../data/familles';

const HORS_CATALOGUE = ['divers', 'homepage', 'racine'];

// 5 photos par famille au maximum : le catalogue donne un aperçu de chaque
// famille et renvoie vers la personnalisation, il ne déverse pas les 179 photos.
const MAX = 5;
const sections = catalogue
  .filter((c) => !HORS_CATALOGUE.includes(c.slug))
  .map((c) => ({ ...c, photos: c.photos.slice(0, MAX), fonds: c.photos.length }));
const total = sections.reduce((n, c) => n + c.photos.length, 0);

// Ancre utilisable dans l'URL : « basics/anse-bois » -> « basics-anse-bois ».
const ancre = (slug: string) => slug.replace(/\//g, '-');

const IG = 'https://www.instagram.com/atelier_acidule';
---

<PageVoeu
  titre="Le catalogue"
  description={`Toutes les créations d'Atelier Acidulé en photos : sacs, pochettes, porte-verres et éditions spéciales.`}
>
  <section class="ca-head">
    <div class="ca-head__wrap reveal">
      <p class="eyebrow" style="color:var(--v-jaune-2)">{sections.length} familles</p>
      <h1 class="display ca-head__title">Le <em>catalogue.</em></h1>
      <p>
        Un aperçu de chaque famille sortie de l'atelier. Chaque pièce se décline
        dans les couleurs et les anses de ton choix&nbsp;: choisis une famille, et
        on compose la tienne.
      </p>
    </div>
  </section>

  {/* Raccourcis vers les familles. Sticky sous le header pour rester à portée
      pendant qu'on fait défiler une longue galerie. */}
  <nav class="ca-filtres" aria-label="Familles de créations">
    <ul>
      {sections.map((c) => (
        <li><a href={`#${ancre(c.slug)}`}>{c.libelle}</a></li>
      ))}
    </ul>
  </nav>

  {sections.map((c) => (
    <section class="ca-sec" id={ancre(c.slug)}>
      <div class="ca-sec__wrap">
        <header class="ca-sec__head reveal">
          <h2 class="display ca-sec__titre">{c.libelle}</h2>
        </header>

        <ul class="ca-grille" data-nb={c.photos.length}>
          {c.photos.map((p, i) => (
            <li class="ca-case">
              <button
                type="button"
                class="ca-vignette"
                data-voir
                data-src={p.src}
                data-w={p.w}
                data-h={p.h}
                data-legende={c.libelle}
                aria-label={`Agrandir : ${c.libelle}, photo ${i + 1} sur ${c.photos.length}`}
              >
                <img
                  src={p.thumb}
                  width={p.tw}
                  height={p.th}
                  alt={`${c.libelle} — photo ${i + 1}`}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>

        {/* Les éditions spéciales ne se personnalisent pas : chaque pièce est
            déjà composée et unique. Leur bouton mène donc à la réservation. */}
        <div class="ca-sec__cta">
          {c.slug === 'editions-speciales' ? (
            <a class="btn-pill btn-pill--jaune" href="/editions-speciales">Voir les éditions spéciales →</a>
          ) : (
            <a class="btn-pill btn-pill--jaune" href={`/commander?modele=${familleDe(c.slug)?.slug ?? ''}`}>
              {familleDe(c.slug)?.cta ?? 'Personnaliser ma pièce'} →
            </a>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="ca-fin">
    <div class="ca-fin__wrap reveal">
      <h2 class="display ca-fin__titre">Une pièce te plaît&nbsp;?</h2>
      <p>Dis-moi le modèle et les couleurs, je la crochète pour toi.</p>
      <div class="ca-fin__actions">
        <a class="btn-pill btn-pill--jaune" href="/commander">Composer ma pièce →</a>
        <a class="btn-pill btn-pill--ghost-light" href={IG} target="_blank" rel="noopener">Poser une question en DM</a>
      </div>
    </div>
  </section>

  {/* Visionneuse. <dialog> gère nativement le focus et la touche Échap. */}
  <dialog class="ca-vue" data-vue aria-label="Photo agrandie">
    <button type="button" class="ca-vue__fermer" data-fermer aria-label="Fermer">×</button>
    <button type="button" class="ca-vue__nav ca-vue__nav--prec" data-prec aria-label="Photo précédente">‹</button>
    <img class="ca-vue__img" data-vue-img alt="" />
    <button type="button" class="ca-vue__nav ca-vue__nav--suiv" data-suiv aria-label="Photo suivante">›</button>
    <p class="ca-vue__legende" data-vue-legende></p>
  </dialog>
</PageVoeu>

<style>
  .ca-head { background: var(--v-vert); color: var(--v-creme); padding: clamp(3rem, 7vw, 5rem) clamp(1.1rem, 4vw, 3rem); }
  .ca-head__wrap { max-width: 780px; margin-inline: auto; }
  .ca-head__title { color: var(--v-creme); font-size: clamp(2.2rem, 5vw, 3.6rem); margin-bottom: 1.1rem; }
  .ca-head__title em { font-style: normal; color: var(--v-jaune); }
  .ca-head p { color: rgba(245, 239, 224, 0.82); max-width: 58ch; }

  /* Barre de familles : sticky, défilement horizontal sur petit écran. */
  .ca-filtres {
    position: sticky; top: 0; z-index: 20;
    background: var(--v-creme); border-bottom: 1px solid rgba(47, 67, 52, 0.12);
  }
  .ca-filtres ul {
    display: flex; gap: 0.5rem; list-style: none; margin: 0;
    padding: 0.7rem clamp(1.1rem, 4vw, 3rem);
    overflow-x: auto; scrollbar-width: none;
  }
  .ca-filtres ul::-webkit-scrollbar { display: none; }
  .ca-filtres a {
    display: block; white-space: nowrap; text-decoration: none;
    font-size: 0.82rem; font-weight: 700; letter-spacing: 0.02em;
    color: var(--v-encre); background: var(--v-creme-2);
    border-radius: 999px; padding: 0.5rem 0.95rem;
  }
  .ca-filtres a span { opacity: 0.5; font-weight: 600; }
  .ca-filtres a:hover { background: var(--v-jaune); }

  .ca-sec { padding: clamp(2.2rem, 5vw, 3.6rem) clamp(1.1rem, 4vw, 3rem) 0; }
  .ca-sec__wrap { max-width: 1180px; margin-inline: auto; }
  .ca-sec__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; }
  .ca-sec__titre { font-size: clamp(1.4rem, 3vw, 2.1rem); }
  .ca-sec__compte { color: var(--v-doux); font-size: 0.85rem; white-space: nowrap; }

  /* Colonnes explicites, pas d'auto-fill : avec 5 photos par famille, une
     grille adaptative laissait une vignette orpheline sur une deuxième ligne. */
  .ca-grille {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(0.5rem, 1.4vw, 0.9rem);
    grid-template-columns: repeat(5, 1fr);
  }
  @media (max-width: 900px) { .ca-grille { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .ca-grille { grid-template-columns: repeat(2, 1fr); } }
  /* 5 photos maximum : sans borne haute, les vignettes s'étireraient sur toute
     la largeur en très grand écran et écraseraient le rythme de la page. */
  .ca-grille { max-width: 1060px; }
  .ca-case { margin: 0; }

  .ca-sec__cta { margin-top: clamp(1.1rem, 2.5vw, 1.6rem); }
  .ca-vignette {
    display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in;
    background: var(--v-creme-2); border-radius: 14px; overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .ca-vignette img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.45s ease;
  }
  .ca-vignette:hover img { transform: scale(1.05); }

  .ca-fin { padding: clamp(3rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3rem); text-align: center; }
  .ca-fin__wrap { max-width: 640px; margin-inline: auto; }
  .ca-fin__titre { font-size: clamp(1.6rem, 3.2vw, 2.2rem); margin-bottom: 0.6rem; }
  .ca-fin p { color: var(--v-doux); }
  .ca-fin__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; margin-top: 1.2rem; }
  /* Le bouton fantôme est dessiné pour fond sombre : sur le crème il lui faut
     une bordure encrée pour rester lisible. */
  .ca-fin .btn-pill--ghost-light { border-color: rgba(47, 67, 52, 0.35); color: var(--v-encre); }

  .ca-vue {
    border: 0; padding: 0; max-width: 100vw; max-height: 100vh;
    width: 100%; height: 100%; background: rgba(28, 36, 30, 0.94);
  }
  .ca-vue::backdrop { background: rgba(28, 36, 30, 0.8); }
  .ca-vue__img {
    display: block; margin: auto; max-width: min(92vw, 900px); max-height: 84vh;
    object-fit: contain; border-radius: 10px;
  }
  .ca-vue__legende {
    position: absolute; left: 0; right: 0; bottom: 1.1rem; text-align: center;
    color: rgba(245, 239, 224, 0.78); font-size: 0.85rem; margin: 0;
  }
  .ca-vue__fermer, .ca-vue__nav {
    position: absolute; border: 0; cursor: pointer; color: var(--v-creme);
    background: rgba(255, 255, 255, 0.12); border-radius: 999px; line-height: 1;
  }
  .ca-vue__fermer { top: 1rem; right: 1rem; width: 44px; height: 44px; font-size: 1.7rem; }
  .ca-vue__nav { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; font-size: 2rem; }
  .ca-vue__nav--prec { left: clamp(0.5rem, 2vw, 1.5rem); }
  .ca-vue__nav--suiv { right: clamp(0.5rem, 2vw, 1.5rem); }
  .ca-vue__fermer:hover, .ca-vue__nav:hover { background: rgba(255, 255, 255, 0.24); }

  @media (max-width: 620px) {
    .ca-sec__head { flex-direction: column; gap: 0.2rem; }
    .ca-vue__nav { width: 40px; height: 40px; font-size: 1.6rem; }
  }
</style>

<script>
  // Visionneuse : la liste est reconstruite depuis le DOM, donc elle suit
  // l'ordre réel des vignettes sans dupliquer les données du catalogue.
  const vue = document.querySelector<HTMLDialogElement>('[data-vue]');
  const img = document.querySelector<HTMLImageElement>('[data-vue-img]');
  const legende = document.querySelector<HTMLElement>('[data-vue-legende]');
  const boutons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-voir]'));

  if (vue && img && legende && boutons.length) {
    let courant = 0;

    const montrer = (i: number) => {
      // Modulo « positif » : -1 doit renvoyer sur la dernière photo.
      courant = (i + boutons.length) % boutons.length;
      const b = boutons[courant];
      img.src = b.dataset.src ?? '';
      img.width = Number(b.dataset.w ?? 0);
      img.height = Number(b.dataset.h ?? 0);
      const txt = b.dataset.legende ?? '';
      img.alt = txt;
      legende.textContent = `${txt} · ${courant + 1} / ${boutons.length}`;
    };

    boutons.forEach((b, i) =>
      b.addEventListener('click', () => {
        montrer(i);
        vue.showModal();
      }),
    );

    document.querySelector('[data-fermer]')?.addEventListener('click', () => vue.close());
    document.querySelector('[data-prec]')?.addEventListener('click', () => montrer(courant - 1));
    document.querySelector('[data-suiv]')?.addEventListener('click', () => montrer(courant + 1));

    vue.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') montrer(courant - 1);
      if (e.key === 'ArrowRight') montrer(courant + 1);
    });

    // Clic sur le fond (et pas sur l'image ou les boutons) = fermeture.
    vue.addEventListener('click', (e) => {
      if (e.target === vue) vue.close();
    });

    // Rendre le focus à la vignette d'où l'on vient, sinon il repart en haut
    // de page et l'utilisateur au clavier perd sa position dans la galerie.
    vue.addEventListener('close', () => boutons[courant]?.focus());
  }
</script>
