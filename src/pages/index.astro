---
// Nouvelle page d'accueil « split éditorial » : accroche + CTA à gauche (crème),
// photo studio héros à droite. Réutilise la coquille Immersif (header + menu).
// L'ancien accueil split-screen est devenu /mes-creations.
import Immersif from '../layouts/Immersif.astro';

const minis = [
  { src: '/images/accueil-mini-1-detoure.png', alt: 'Sac bordeaux au crochet' },
  { src: '/images/accueil-mini-2-detoure.png', alt: 'Cabas marron aux anses laiton' },
  { src: '/images/accueil-mini-3-detoure.png', alt: 'Sac rose au crochet' },
];
---

<Immersif titre="Accueil">
  <section class="hero">
    <!-- Gauche : accroche + CTA -->
    <div class="hero__left">
      <div class="hero__content">
        <p class="hero__surtitre">Crochet fait main · Méditerranée</p>
        <h1 class="hero__titre">Une pointe d'acidulé,<br />cousue main rien que pour toi.</h1>
        <p class="hero__sous">
          Des sacs et accessoires au crochet, faits à la demande, dans les
          couleurs que tu choisis. Des pièces uniques, à l'esprit sucré-doux.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primaire" href="/personnaliser">Personnaliser mon sac</a>
          <a class="btn btn--secondaire" href="/mes-creations">Voir mes créations</a>
        </div>

        <a class="hero__gallery" href="/mes-creations" aria-label="Voir toutes mes créations">
          {minis.map((m) => <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />)}
          <span class="hero__gallery-plus">+ de créations →</span>
        </a>
      </div>
    </div>

    <!-- Droite : photo studio héros -->
    <div class="hero__right">
      <img
        class="hero__photo"
        src="/images/accueil-hero-detoure.png"
        alt="Sac au crochet vert anis, anse tressée et charm fleur"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <style>
    .hero {
      height: 100dvh;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      background: var(--creme);
    }

    /* --- Colonne gauche : texte --- */
    .hero__left {
      display: flex;
      align-items: center;
      padding: clamp(2rem, 6vw, 5rem);
      padding-top: clamp(5rem, 10vh, 7rem); /* sous le header fixe */
    }
    .hero__content { max-width: 30rem; }
    .hero__surtitre {
      margin: 0 0 1rem;
      font-family: var(--font-corps);
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--olive);
    }
    .hero__titre {
      margin: 0;
      font-family: var(--font-titre);
      font-weight: 600;
      font-size: clamp(2.1rem, 4.6vw, 3.6rem);
      line-height: 1.05;
      color: var(--sapin);
    }
    .hero__sous {
      margin: 1.2rem 0 0;
      font-size: clamp(1rem, 1.4vw, 1.12rem);
      line-height: 1.6;
      color: var(--texte-doux);
    }

    /* --- CTA --- */
    .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.85rem 1.5rem;
      border-radius: 999px;
      font-family: var(--font-corps);
      font-weight: 700;
      text-decoration: none;
      transition: var(--transition);
    }
    .btn--primaire { background: var(--sapin); color: var(--creme); }
    .btn--primaire:hover { background: var(--sapin-2); transform: translateY(-2px); }
    .btn--secondaire { border: 1.5px solid var(--sauge); color: var(--sapin); }
    .btn--secondaire:hover { background: var(--sauge-clair); }

    /* --- Mini galerie --- */
    .hero__gallery {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 2.4rem;
      text-decoration: none;
    }
    .hero__gallery img {
      width: clamp(48px, 6vw, 64px);
      height: clamp(48px, 6vw, 64px);
      object-fit: contain;
      filter: drop-shadow(0 6px 9px rgba(20, 12, 8, 0.18));
      transition: var(--transition);
    }
    .hero__gallery:hover img { transform: translateY(-3px); }
    .hero__gallery-plus {
      font-family: var(--font-corps);
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--terracotta);
      margin-left: 0.3rem;
    }

    /* --- Colonne droite : sac détouré qui flotte sur le crème (pas de bloc photo) --- */
    .hero__right { position: relative; overflow: hidden; background: transparent; }
    /* halo doux derrière le sac pour la profondeur (premium, sans cadre) */
    .hero__right::before {
      content: '';
      position: absolute;
      inset: 12% 8%;
      z-index: 0;
      border-radius: 50%;
      background: radial-gradient(closest-side, color-mix(in srgb, var(--citron) 24%, transparent), transparent 72%);
      filter: blur(10px);
    }
    .hero__photo {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: clamp(1rem, 3vw, 2.5rem);
      filter: drop-shadow(0 30px 36px rgba(20, 12, 8, 0.20));
    }

    /* --- Mobile : on empile (photo en haut), hauteur naturelle, la page scrolle
       nativement (la home n'est PAS en mode `fixe`, cf. Immersif). --- */
    @media (max-width: 760px) {
      .hero {
        height: auto;
        min-height: 100dvh;
        grid-template-columns: 1fr;
        grid-template-rows: auto auto;
      }
      .hero__right { order: -1; height: 52dvh; }
      .hero__left {
        padding-top: 2rem;
        padding-bottom: 3.5rem;
        align-items: start;
      }
    }
  </style>
</Immersif>
