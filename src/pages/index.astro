  .avis__dot.actif { background: var(--v-jaune-2); transform: scale(1.25); }
  .stars { color: var(--v-jaune); letter-spacing: 2px; margin-bottom: 0.7rem; }
  .temoignage blockquote { margin: 0 0 0.9rem; font-style: italic; color: var(--v-encre); }
  .temoignage figcaption { font-family: 'Archivo', sans-serif; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; font-size: 0.78rem; }

  /* ---------- CTA jaune ---------- */
  .cta-band { background: var(--v-jaune); }
  .cta-band__wrap { max-width: 1200px; margin-inline: auto; padding: clamp(2.4rem, 5vw, 3.6rem) clamp(1.1rem, 4vw, 3rem); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1.4rem 2rem; }
  .cta-band__title { grid-row: 1; color: var(--v-encre); font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
