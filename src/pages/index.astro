      margin-inline: calc(var(--px) * -1); padding-inline: var(--px);
    }
    .cards::-webkit-scrollbar { display: none; }
    .card { scroll-snap-align: center; }
    .card__nom { font-size: 0.9rem; }
    .card__prix { font-size: 0.95rem; }
  }

  @media (max-width: 520px) {
    .hero__atouts { gap: 0.8rem 1.4rem; }
    .site-foot__wrap { grid-template-columns: 1fr; }
  }
</style>

<script>
  // --- burger / tiroir ---
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    drawer?.setAttribute('aria-hidden', String(open));
    document.body.style.overflow = open ? '' : 'hidden';
  });
  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      burger?.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    })
  );

  // --- ombre du header au scroll ---
  const head = document.querySelector<HTMLElement>('[data-head]');
  const onScroll = () => head?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // --- reveal au scroll ---
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
    { threshold: 0.14 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // --- carrousel d'avis (mobile : scroll ; flèches partout) ---
  const track = document.querySelector<HTMLElement>('[data-avis-track]');
  const step = (dir: number) => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('.temoignage');
    const w = card ? card.getBoundingClientRect().width + 24 : track.clientWidth;
    track.scrollBy({ left: dir * w, behavior: 'smooth' });
  };
  document.querySelector('[data-avis-prev]')?.addEventListener('click', () => step(-1));
  document.querySelector('[data-avis-next]')?.addEventListener('click', () => step(1));

  // --- points indicateurs des avis (visibles en mobile, où le carrousel est tactile) ---
  const dotsWrap = document.querySelector<HTMLElement>('[data-avis-dots]');
  const slides = track ? Array.from(track.querySelectorAll('.temoignage')) : [];
  if (dotsWrap && track && slides.length > 1) {
    slides.forEach(() => {
      const d = document.createElement('span');
      d.className = 'avis__dot';
      dotsWrap.append(d);
    });
    const dots = Array.from(dotsWrap.children);
    const majDots = () => {
      const max = track.scrollWidth - track.clientWidth;
      const i = max > 0 ? Math.round((track.scrollLeft / max) * (slides.length - 1)) : 0;
      dots.forEach((d, j) => d.classList.toggle('actif', j === i));
    };
    majDots();
    track.addEventListener('scroll', majDots, { passive: true });
  }
</script>

