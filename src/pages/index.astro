  /* ---------- avis ---------- */
  .avis { padding: clamp(3rem, 6vw, 5rem) clamp(1.1rem, 4vw, 3rem); }
  .avis__wrap { max-width: 1200px; margin-inline: auto; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(1rem, 3vw, 2.4rem); }
  .avis__head { grid-column: 2; margin-bottom: 0.5rem; }
  .avis__title { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .avis__title::after { content:''; display:block; width: 46px; height: 3px; background: var(--v-jaune); margin-top: 0.7rem; }
  .avis__track { grid-column: 2; grid-row: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.6rem); }
  .nav-arrow { grid-row: 1 / span 2; align-self: center; width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid var(--v-ligne); background: transparent; cursor: pointer; display: grid; place-items: center; color: var(--v-encre); transition: background .25s ease, color .25s ease; }
  .nav-arrow:hover { background: var(--v-vert); color: var(--v-creme); }
