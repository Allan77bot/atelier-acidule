  /* ---------- footer ---------- */
  .site-foot { background: var(--v-vert-2); color: var(--v-creme); padding: clamp(2.5rem, 5vw, 3.6rem) clamp(1.1rem, 4vw, 3rem) 1.6rem; }
  .site-foot__wrap { max-width: 1200px; margin-inline: auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.6fr; gap: clamp(1.4rem, 3vw, 2.4rem); }
  .brand--foot .brand__txt, .brand--foot .brand__txt strong, .brand--foot .brand__txt small { color: var(--v-creme); }
  .foot-col { display: flex; flex-direction: column; gap: 0.5rem; }
  .foot-col h4, .newsletter h4 { font-family: 'Archivo', sans-serif; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 700; color: var(--v-jaune); margin: 0 0 0.4rem; }
  .foot-col a { color: rgba(245,239,224,.78); font-size: 0.9rem; }
  .foot-col a:hover { color: var(--v-creme); }
  .newsletter__row { display: flex; gap: 0; background: rgba(245,239,224,.1); border-radius: 999px; padding: 4px; max-width: 320px; }
  .newsletter input { flex: 1; background: none; border: 0; color: var(--v-creme); padding: 0.6rem 1rem; font: inherit; font-size: 0.9rem; }
  .newsletter input::placeholder { color: rgba(245,239,224,.55); }
  .newsletter input:focus { outline: none; }
  .newsletter button { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--v-jaune); color: var(--v-encre); cursor: pointer; display: grid; place-items: center; }
  .site-foot__legal { max-width: 1200px; margin: 2.4rem auto 0; padding-top: 1.4rem; border-top: 1px solid rgba(245,239,224,.14); font-size: 0.8rem; color: rgba(245,239,224,.6); }

  /* =========================================================
     RESPONSIVE
     ========================================================= */
  @media (max-width: 960px) {
    .site-nav { display: none; }
    .burger { display: flex; }
    .brand { margin-right: auto; }
    /* le CTA reste visible : seul chemin d'achat permanent sur mobile */
    .head-cta { padding: 0.72rem 1.15rem; font-size: 0.72rem; }

    /* hero : titre -> visuel -> sous-titre + CTA */
    .hero { padding-top: 1.4rem; }
    .hero__wrap { grid-template-columns: 1fr; grid-template-areas: 'head' 'visual' 'body'; }
    .hero__head { text-align: center; }
    .hero__title { font-size: clamp(1.85rem, 8.4vw, 2.9rem); }
    .hero__panel { max-width: min(70vw, 320px); margin-inline: auto; margin-top: 1.2rem; padding: 1.5rem; }
    .hero__sub { margin-top: 1.6rem; }
    .hero__body { justify-items: center; display: grid; text-align: center; }
    .hero__cta { justify-content: center; }
    .hero__atouts { justify-content: center; }

    .valeurs__grid { grid-template-columns: repeat(2, 1fr); }
    .valeur:nth-child(3) { border-left: 0; }
    .valeur:nth-child(odd) { border-left: 0; }
    .valeur:nth-child(even) { border-left: 1px solid rgba(245,239,224,.14); }
    .valeur { border-top: 1px solid rgba(245,239,224,.14); }
    .valeur:nth-child(1), .valeur:nth-child(2) { border-top: 0; }
    .collection__wrap { grid-template-columns: 1fr; }
    .collection__intro { text-align: center; }
    .cards { grid-template-columns: repeat(2, 1fr); }
    .apropos { grid-template-columns: 1fr; }
    .apropos__img { order: -1; }

    /* avis : tout le carrousel est tactile -> flèches inutiles, points indicateurs */
    .avis__wrap { grid-template-columns: 1fr; }
    .avis__head, .avis__track { grid-column: 1; }
    .avis__head { text-align: center; }
    .avis__title::after { margin-inline: auto; }
    .avis__track { grid-row: auto; grid-auto-flow: column; grid-auto-columns: 88%; grid-template-columns: none; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .avis__track::-webkit-scrollbar { display: none; }
    .temoignage { scroll-snap-align: center; text-align: center; }
    .nav-arrow { display: none; }
    .avis__dots { display: flex; justify-content: center; gap: 8px; grid-column: 1; margin-top: 1.4rem; }

    .cta-band__wrap { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .cta-band__title, .cta-band__txt, .cta-band .btn-pill { grid-column: 1; }
    .cta-band .btn-pill { grid-row: 3; }
    .site-foot__wrap { grid-template-columns: 1fr 1fr; }
    .brand--foot, .newsletter { grid-column: 1 / -1; }
    .newsletter input { font-size: 16px; } /* < 16px = zoom auto iOS au focus */
  }

  /* collection : carrousel plein-bleed avec aperçu de la carte suivante */
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%;
      overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
