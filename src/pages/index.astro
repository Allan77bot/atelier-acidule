---
// Accueil — reproduction fidèle de la maquette Ref/_preview/AtelierAcidule_ref.jpeg
// (boutique de sacs crochet). Page vitrine longue, scroll classique, mobile-first.
// Header + footer inline pour coller pixel-près à la maquette. Un seul <script>
// (burger + carrousel d'avis + reveal au scroll).
import Vitrine from '../layouts/Vitrine.astro';
import { catalogue } from '../data/catalogue';
import { groupes, famillesDuGroupe } from '../data/familles';

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/creations', label: 'Les créations' },
  { href: '/editions-speciales', label: 'Éditions spéciales' },
  { href: '/atelier', label: 'À propos' },
  { href: '/commander', label: 'Contact' },
];

// Atouts du hero (mini-rangée sous les CTA)
const atouts = [
  { i: 'coeur', t: 'Fait main avec amour' },
  { i: 'feuille', t: 'Matériaux durables' },
  { i: 'etoile', t: 'Pièces uniques' },
  { i: 'france', t: 'Fabriqué en France' },
];

// Bandeau vert : 4 valeurs
const valeurs = [
  { i: 'main', t: 'Fait main', d: 'Chaque pièce est réalisée à la main avec soin.' },
  { i: 'feuille', t: 'Éco-responsable', d: 'Des fils sélectionnés avec attention pour la planète.' },
  { i: 'palette', t: 'Design unique', d: 'Des modèles originaux et intemporels.' },
  { i: 'coeur', t: 'Petites séries', d: "Des créations en petites quantités pour plus d'authenticité." },
];

// Collection — les 4 univers réellement fabriqués, tels que Marine range ses
// photos. La page présentait jusqu'ici 4 « modèles » qui ne correspondaient pas
// à sa production : ni porte-verres, ni pochettes.
// La vignette est la photo choisie via `vignette` (les porte-verres commencent
// par des visuels promo), sinon la première du dossier.
const APERCU: Record<string, { dot: string; detail: string }> = {
  'sacs':          { dot: '#c75c39', detail: 'Anse bois, crochetée ou dorée' },
  'sacs-de-plage': { dot: '#7b2d3a', detail: 'Grand format, porté épaule' },
  'porte-verres':  { dot: '#6f7c3c', detail: 'Se porte en sautoir' },
  'pochettes':     { dot: '#2f4334', detail: 'Livre, téléphone, ordinateur' },
};
const produits = groupes.map((g) => {
  const premiere = famillesDuGroupe(g.slug)[0];
  const ph = catalogue.find((c) => c.slug === premiere.categorie)?.photos ?? [];
  const photo = ph[premiere.vignette ?? 0] ?? ph[0];
  return {
    nom: g.nom,
    detail: APERCU[g.slug].detail,
    dot: APERCU[g.slug].dot,
    img: photo?.thumb ?? '',
    href: `/creations#${g.slug}`,
  };
});

// Avis clientes
const avis = [
  { txt: 'Sac magnifique, encore plus beau en vrai ! Finitions parfaites.', nom: 'Claire' },
  { txt: 'Une création unique et de qualité. Je recommande à 100 % !', nom: 'Marion' },
  { txt: "J'adore mon sac, il attire tous les regards !", nom: 'Laura' },
];

// Petites icônes SVG inline (stroke = currentColor), rendues via set:html.
const S = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const icons: Record<string, string> = {
  coeur: `<svg ${S}><path d="M12 20s-7-4.6-9.4-8.9A5 5 0 0 1 12 6.2 5 5 0 0 1 21.4 11C19 15.4 12 20 12 20z"/></svg>`,
  feuille: `<svg ${S}><path d="M11 20A7 7 0 0 1 4 13C4 7 12 4 20 4c0 8-3 16-9 16z"/><path d="M8.5 16.5C12 13 14 11 16 9"/></svg>`,
  etoile: `<svg ${S}><path d="M12 3l2.2 5.2L20 9l-4 3.8L17 19l-5-2.9L7 19l1-6.2L4 9l5.8-.8L12 3z"/></svg>`,
  france: `<svg ${S}><path d="M12 3l7 4v6c0 4-3 6.5-7 8-4-1.5-7-4-7-8V7l7-4z"/></svg>`,
  main: `<svg ${S}><circle cx="12" cy="8" r="4"/><path d="M12 12v9"/><path d="M9 21h6"/></svg>`,
  palette: `<svg ${S}><path d="M12 3a9 9 0 1 0 0 18c1.4 0 2-1 2-2 0-1.4 1-2 2.2-2H18a3 3 0 0 0 3-3 8 8 0 0 0-9-8z"/><circle cx="7.5" cy="12" r="1"/><circle cx="10" cy="7.5" r="1"/><circle cx="15" cy="7.5" r="1"/></svg>`,
  gauche: `<svg ${S}><path d="M15 18l-6-6 6-6"/></svg>`,
  droite: `<svg ${S}><path d="M9 6l6 6-6 6"/></svg>`,
  envoi: `<svg ${S}><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>`,
};
const icon = (k: string): string => icons[k] ?? '';
---

<Vitrine titre="Accueil" description="Sacs en crochet faits main, uniques et durables — L'Atelier Acidulé. L'art du crochet, la douceur du fait main.">
  <!-- ============================ HEADER ============================ -->
  <header class="site-head" data-head>
    <a class="brand" href="/" aria-label="L'Atelier Acidulé — accueil">
      <img class="brand__logo" src="/images/logo.png" alt="" width="52" height="52" decoding="async" />
      <span class="brand__txt"><small>L'ATELIER</small><strong>ACIDULÉ</strong></span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="btn-pill btn-pill--jaune head-cta" href="/commander">Commander</a>

    <button class="burger" data-burger aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- tiroir mobile -->
  <nav id="drawer" class="drawer" data-drawer aria-hidden="true" aria-label="Menu">
    <div class="drawer__inner">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn-pill btn-pill--jaune drawer__cta" href="/commander">Commander</a>
    </div>
  </nav>

  <main>
    <!-- ============================ HERO ============================ -->
    <section class="hero">
      <div class="hero__wrap">
        <div class="hero__head reveal">
          <p class="eyebrow">Crochet fait main · Méditerranée</p>
          <h1 class="display hero__title">Une pointe d'<em>acidulé,</em><br />cousue main rien que pour toi.</h1>
        </div>

        <div class="hero__body reveal">
          <p class="hero__sub">Des sacs et accessoires au crochet, faits à la demande, dans les couleurs que tu choisis. Des pièces uniques, à l'esprit sucré-doux.</p>
          <div class="hero__cta">
            <a class="btn-pill btn-pill--jaune" href="/commander">Commander mon sac</a>
            <a class="btn-pill btn-pill--ghost" href="/creations">Voir les créations</a>
          </div>
          <ul class="hero__atouts">
            {atouts.map((a) => (
              <li><span class="ic" set:html={icon(a.i)} /> {a.t}</li>
            ))}
          </ul>
        </div>

        <div class="hero__visual reveal">
          <div class="hero__panel">
            <img src="/images/hero-crochet.webp" alt="Sac en crochet fait main aux motifs fleuris" decoding="async" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <!-- ======================= BANDEAU VALEURS ======================= -->
    <section class="valeurs">
      <div class="valeurs__grid">
        {valeurs.map((v) => (
          <div class="valeur reveal">
            <span class="valeur__ic" set:html={icon(v.i)} />
            <h3 class="valeur__t">{v.t}</h3>
            <p class="valeur__d">{v.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ========================= COLLECTION ========================= -->
    <section class="collection">
      <div class="collection__wrap">
        <aside class="collection__intro reveal">
          <p class="eyebrow">Collection</p>
          <h2 class="display collection__title">Nos créations<br />au crochet</h2>
          <a class="btn-pill btn-pill--jaune" href="/creations">Voir toutes les créations</a>
        </aside>

        <div class="cards" role="list">
          {produits.map((p) => (
            <a class="card reveal" href={p.href} role="listitem">
              <span class="card__media"><img src={p.img} alt={p.nom} loading="lazy" decoding="async" /></span>
              <span class="card__row">
                <span class="card__nom">{p.nom}</span>
                <span class="card__dot" style={`--d:${p.dot}`}></span>
              </span>
              <span class="card__prix">{p.detail}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- =========================== À PROPOS ========================== -->
    <section class="apropos">
      <div class="apropos__img reveal">
        <img src="/images/about-atelier.webp" alt="Sac en crochet en cours de création, pelote et crochet" loading="lazy" decoding="async" />
      </div>
      <div class="apropos__text reveal">
        <p class="eyebrow eyebrow--jaune">L'atelier</p>
        <h2 class="display apropos__title">Du fil, des couleurs,<br />beaucoup de peps.</h2>
        <p>Tout part d'une pelote et d'une envie. Je crochète chaque pièce à la main, près de chez moi, en soignant le moindre détail.</p>
        <p>Inspiré par l'Italie et la Méditerranée : l'acidulé et le sucré-doux à la fois.</p>
        <a class="btn-pill btn-pill--jaune" href="/atelier">Découvrir l'atelier</a>
        <svg class="apropos__lemon" viewBox="0 0 120 120" aria-hidden="true"><ellipse cx="62" cy="66" rx="34" ry="30" /><path d="M38 46c8-14 24-20 40-16" /><path d="M74 30c6-6 16-8 22-4-2 8-10 14-18 14" /></svg>
      </div>
    </section>

    <!-- ============================ AVIS ============================ -->
    <section class="avis">
      <div class="avis__wrap">
        <div class="avis__head reveal">
          <p class="eyebrow">Elles en parlent</p>
          <h2 class="display avis__title">Vos avis</h2>
        </div>
        <button class="nav-arrow" data-avis-prev aria-label="Avis précédent" set:html={icon('gauche')}></button>
        <div class="avis__track" data-avis-track>
          {avis.map((a) => (
            <figure class="temoignage">
              <div class="stars" aria-label="5 sur 5">{'★★★★★'}</div>
              <blockquote>{a.txt}</blockquote>
              <figcaption>{a.nom}</figcaption>
            </figure>
          ))}
        </div>
        <button class="nav-arrow" data-avis-next aria-label="Avis suivant" set:html={icon('droite')}></button>
        <div class="avis__dots" data-avis-dots aria-hidden="true"></div>
      </div>
    </section>

    <!-- ========================= CTA JAUNE ========================= -->
    <section class="cta-band">
      <div class="cta-band__wrap">
        <h2 class="display cta-band__title">Commande ta pièce<br />unique.</h2>
        <p class="cta-band__txt">Fait main en France, sur commande. On confirme couleurs et délai en DM.</p>
        <a class="btn-pill btn-pill--sombre" href="https://instagram.com/atelier_acidule" target="_blank" rel="noopener">Commander sur Instagram</a>
      </div>
    </section>
  </main>

  <!-- ============================ FOOTER ============================ -->
  <footer class="site-foot">
    <div class="site-foot__wrap">
      <a class="brand brand--foot" href="/">
        <img class="brand__logo" src="/images/logo.png" alt="" width="48" height="48" decoding="async" />
        <span class="brand__txt"><small>L'ATELIER</small><strong>ACIDULÉ</strong></span>
      </a>

      <div class="foot-col">
        <h4>Navigation</h4>
        <a href="/">Accueil</a><a href="/creations">Les créations</a><a href="/editions-speciales">Éditions spéciales</a><a href="/atelier">À propos</a><a href="/commander">Contact</a>
      </div>
      <div class="foot-col">
        <h4>Informations</h4>
        <a href="/commander">Livraison &amp; retours</a><a href="/atelier">Conditions générales</a><a href="/atelier">FAQ</a>
      </div>
      <div class="foot-col">
        <h4>Suivez-nous</h4>
        <a href="https://instagram.com/atelier_acidule" target="_blank" rel="noopener">@atelier_acidule</a><a href="https://instagram.com/atelier_acidule" target="_blank" rel="noopener">Commander en DM</a>
      </div>

      <form class="newsletter" onsubmit="return false">
        <h4>Recevez nos nouveautés</h4>
        <div class="newsletter__row">
          <input type="email" placeholder="Votre email" aria-label="Votre email" required />
          <button type="submit" aria-label="S'inscrire" set:html={icon('envoi')}></button>
        </div>
      </form>
    </div>
    <p class="site-foot__legal">© 2026 L'Atelier Acidulé. Tous droits réservés.</p>
  </footer>
</Vitrine>

<style>
  main { display: block; }

  /* ---------- primitives ---------- */
  .eyebrow {
    font-family: 'Archivo', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--v-doux);
    margin: 0 0 0.9rem;
  }
  .eyebrow--jaune { color: var(--v-jaune); }

  .btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform var(--transition), background-color var(--transition), color var(--transition), box-shadow var(--transition);
    white-space: nowrap;
  }
  .btn-pill--jaune { background: var(--v-jaune); color: var(--v-encre); }
  .btn-pill--jaune:hover { background: var(--v-jaune-2); transform: translateY(-2px); color: var(--v-encre); }
  .btn-pill--ghost { background: transparent; color: var(--v-encre); border-color: rgba(43,42,34,0.35); }
  .btn-pill--ghost:hover { background: var(--v-encre); color: var(--v-creme); }
  .btn-pill--sombre { background: var(--v-vert); color: var(--v-creme); }
  .btn-pill--sombre:hover { background: var(--v-vert-2); transform: translateY(-2px); color: var(--v-creme); }

  .ic svg, .valeur__ic svg { display: block; }
  .ic svg { width: 18px; height: 18px; }

  /* reveal au scroll */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; } }

  /* ---------- header ---------- */
  .site-head {
    position: sticky; top: 0; z-index: 60;
    display: flex; align-items: center; gap: 1.4rem;
    padding: 0.8rem clamp(1.1rem, 4vw, 3rem);
    background: rgba(245,239,224,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: box-shadow .3s ease, border-color .3s ease;
  }
  .site-head[data-scrolled] { box-shadow: 0 10px 30px -22px rgba(43,42,34,.5); border-color: var(--v-ligne); }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .brand__logo { height: 46px; width: auto; border-radius: 50%; }
  .brand__txt { display: flex; flex-direction: column; line-height: 0.92; font-family: 'Archivo', sans-serif; color: var(--v-encre); }
  .brand__txt small { font-size: 0.62rem; letter-spacing: 0.18em; font-weight: 600; }
  .brand__txt strong { font-size: 1.28rem; letter-spacing: 0.02em; font-weight: 900; }

  .site-nav { display: flex; gap: clamp(1rem, 2.4vw, 2rem); margin-inline: auto; }
  .site-nav a {
    font-family: 'Archivo', sans-serif; font-weight: 600; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--v-encre);
    padding: 0.4rem 0; position: relative;
  }
  .site-nav a::after { content:''; position:absolute; left:0; right:100%; bottom:-2px; height:2px; background: var(--v-jaune); transition: right .25s ease; }
  .site-nav a:hover { color: var(--v-encre); }
  .site-nav a:hover::after { right: 0; }
  .head-cta { margin-left: 0; }

  .burger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; min-height: 44px; padding: 9px; background: none; border: 0; cursor: pointer; }
  .burger span { height: 2px; width: 100%; background: var(--v-encre); border-radius: 2px; transition: transform .25s ease, opacity .2s ease; }
  .burger[aria-expanded='true'] span:nth-child(1){ transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2){ opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3){ transform: translateY(-7px) rotate(-45deg); }

  .drawer { position: fixed; inset: 0; z-index: 55; background: var(--v-vert); display: grid; place-items: center; opacity: 0; visibility: hidden; transition: opacity .35s ease, visibility .35s ease; }
  .drawer[aria-hidden='false'] { opacity: 1; visibility: visible; }
  .drawer__inner { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .drawer__inner a { font-family: 'Archivo', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(1.6rem, 7vw, 2.4rem); color: var(--v-creme); padding: 0.4rem 0; }
  .drawer__inner a:hover { color: var(--v-jaune); }
  .drawer__cta { margin-top: 1.2rem; font-size: 0.9rem; color: var(--v-encre); }

  /* ---------- hero ---------- */
  .hero { padding: clamp(2rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem); }
  /* head (eyebrow+titre) et body (sub+CTA+atouts) séparés pour pouvoir
     intercaler le visuel entre les deux sur mobile. */
  .hero__wrap {
    max-width: 1200px; margin-inline: auto; display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: 'head visual' 'body visual';
    column-gap: clamp(2rem, 5vw, 4rem); row-gap: 0;
    align-items: center;
  }
  .hero__head { grid-area: head; align-self: end; }
  .hero__body { grid-area: body; align-self: start; }
  .hero__visual { grid-area: visual; }
  .hero__title { font-size: clamp(2.4rem, 6.2vw, 4.4rem); }
  .hero__title em { font-style: normal; color: var(--v-jaune); }
  .hero__sub { max-width: 30rem; margin: 1.4rem 0 2rem; color: var(--v-doux); font-size: 1.05rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .hero__atouts { list-style: none; margin: 2.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: clamp(1rem, 3vw, 2.2rem); }
  .hero__atouts li { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; font-weight: 600; color: var(--v-encre); }
  .hero__atouts .ic { color: var(--v-jaune-2); display: inline-flex; }

  .hero__panel { position: relative; background: var(--v-vert); border-radius: 26px; padding: 2.2rem; aspect-ratio: 4/5; display: grid; place-items: center; overflow: hidden; }
  /* La photo a son propre fond crème : on arrondit ses coins comme ceux du
     panneau, sinon on voit deux rectangles imbriqués aux angles différents. */
  .hero__panel img { width: 100%; height: 100%; object-fit: contain; border-radius: 14px; }

  /* ---------- bandeau valeurs ---------- */
  .valeurs { background: var(--v-vert); color: var(--v-creme); }
  .valeurs__grid { max-width: 1200px; margin-inline: auto; display: grid; grid-template-columns: repeat(4, 1fr); }
  .valeur { padding: clamp(2rem, 4vw, 3rem) clamp(1.1rem, 2.5vw, 2rem); border-left: 1px solid rgba(245,239,224,.14); }
  .valeur:first-child { border-left: 0; }
  .valeur__ic { color: var(--v-jaune); display: inline-flex; margin-bottom: 1rem; }
  .valeur__ic svg { width: 30px; height: 30px; }
  .valeur__t { font-family: 'Archivo', sans-serif; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.95rem; font-weight: 700; color: var(--v-creme); margin: 0 0 0.5rem; }
  .valeur__d { color: rgba(245,239,224,.7); font-size: 0.9rem; margin: 0; }

  /* ---------- collection ---------- */
  .collection { --px: clamp(1.1rem, 4vw, 3rem); padding: clamp(3rem, 7vw, 5.5rem) var(--px); }
  .collection__wrap { max-width: 1200px; margin-inline: auto; display: grid; grid-template-columns: 240px 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .collection__title { font-size: clamp(2rem, 3.6vw, 2.8rem); margin: 0 0 1.6rem; }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.8rem, 1.6vw, 1.3rem); }
  .card { display: flex; flex-direction: column; text-decoration: none; color: var(--v-encre); }
  .card__media { display: block; background: var(--v-creme-2); border-radius: 14px; overflow: hidden; aspect-ratio: 3/4; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover .card__media img { transform: scale(1.05); }
  .card__row { display: flex; align-items: center; justify-content: space-between; margin-top: 0.8rem; }
  .card__nom { font-family: 'Archivo', sans-serif; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 700; font-size: 0.82rem; }
  .card__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--d); box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
  .card__prix { color: var(--v-doux); font-size: 0.85rem; margin-top: 0.15rem; }
  .card__prix strong { color: var(--v-encre); font-weight: 800; }

  /* ---------- à propos ---------- */
  .apropos { display: grid; grid-template-columns: 1fr 1fr; background: var(--v-vert); color: var(--v-creme); }
  .apropos__img img { width: 100%; height: 100%; object-fit: cover; min-height: 320px; }
  .apropos__text { position: relative; padding: clamp(2.5rem, 6vw, 5rem); align-self: center; overflow: hidden; }
  .apropos__title { color: var(--v-creme); font-size: clamp(1.9rem, 3.6vw, 2.8rem); margin: 0 0 1.2rem; }
  .apropos__text p { color: rgba(245,239,224,.82); max-width: 34rem; }
  .apropos__text .btn-pill { margin-top: 1.2rem; }
