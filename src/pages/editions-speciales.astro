---
// Éditions spéciales — DA « voeu ». Galerie de pièces uniques, contenu réel conservé.
import PageVoeu from '../layouts/PageVoeu.astro';

import { catalogue } from '../data/catalogue';

const IG = 'https://www.instagram.com/atelier_acidule';

// Les vraies photos d'éditions spéciales du Drive. On ne leur invente ni nom
// ni statut de disponibilité : ces pièces changent au fil des saisons et seule
// la cliente sait ce qui reste — la réservation passe par le DM.
const pieces = catalogue.find((c) => c.slug === 'editions-speciales')?.photos ?? [];
---

<PageVoeu titre="Éditions spéciales" description="Des pièces uniques au crochet, en quantité limitée. Quand elles sont parties, elles sont parties.">
  <section class="ed-head">
    <div class="ed-head__wrap reveal">
      <p class="eyebrow" style="color:var(--v-jaune-2)">En quantité limitée</p>
      <h1 class="display ed-head__title">Éditions <em>spéciales.</em></h1>
      <p>Des créations composées à la main au gré des saisons. Ici, pas de configurateur : chaque pièce est déjà pensée dans ses moindres mailles. Un coup de cœur&nbsp;? Réserve-la vite en DM.</p>
    </div>
  </section>

  <section class="ed-gallery-sec">
    <div class="ed-gallery">
      {pieces.map((p, i) => (
        <figure class="ed-piece reveal">
          <img
            src={p.thumb}
            width={p.tw}
            height={p.th}
            alt={`Édition spéciale — pièce ${i + 1}`}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
      ))}
    </div>

    <div class="ed-cta reveal">
      <p>Une pièce te fait de l'œil&nbsp;? Elles partent vite — envoie-moi un message pour savoir si elle est encore là.</p>
      <a class="btn-pill btn-pill--jaune" href={IG} target="_blank" rel="noopener">Réserver en DM</a>
    </div>
  </section>
</PageVoeu>

<style>
  .ed-head { background: var(--v-vert); color: var(--v-creme); padding: clamp(3rem, 7vw, 5rem) clamp(1.1rem, 4vw, 3rem); text-align: center; }
  .ed-head__wrap { max-width: 640px; margin-inline: auto; }
  .ed-head__title { color: var(--v-creme); font-size: clamp(2.2rem, 5vw, 3.4rem); margin-bottom: 1rem; }
  .ed-head__title em { font-style: normal; color: var(--v-jaune); }
  .ed-head p { color: rgba(245,239,224,.8); }

  .ed-gallery-sec { padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3rem); }
  .ed-gallery {
    max-width: 1150px; margin-inline: auto;
    display: grid; gap: clamp(0.6rem, 1.5vw, 1.1rem);
    grid-template-columns: repeat(auto-fill, minmax(clamp(150px, 22vw, 250px), 1fr));
  }
  .ed-piece {
    margin: 0; background: var(--v-creme-2); border-radius: 18px; overflow: hidden;
    aspect-ratio: 3 / 4;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .ed-piece:hover { transform: translateY(-4px); box-shadow: 0 22px 50px -30px rgba(43,42,34,.5); }
  .ed-piece img { width: 100%; height: 100%; object-fit: cover; }

  .ed-cta { max-width: 620px; margin: clamp(2.2rem, 5vw, 3.4rem) auto 0; text-align: center; }
  .ed-cta p { color: var(--v-doux); margin-bottom: 1.1rem; }
</style>
