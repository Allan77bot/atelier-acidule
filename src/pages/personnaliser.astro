---
import Base from '../layouts/Base.astro';
import Configurateur from '../components/Configurateur.astro';
---

<Base
  titre="Personnaliser"
  description="Compose ton sac au crochet teinte par teinte : jusqu'à 3 couleurs, anse laine ou laiton, conseils de mariage de couleurs."
>
  <section class="section">
    <div class="contenu">
      <header class="entete">
        <p class="surtitre">Le studio des couleurs</p>
        <h1>Personnalise ta création</h1>
        <p class="entete__sous">
          Choisis ton modèle, recolore-le jusqu'à <strong>3 teintes</strong>,
          pioche ton type d'anse — et laisse les conseils de mariage te guider.
          Aperçu vectoriel, couleurs illimitées.
        </p>
      </header>
      <Configurateur />
    </div>
  </section>
</Base>

<style>
  .entete { text-align: center; max-width: 56ch; margin: 0 auto 2.6rem; }
  .entete__sous { color: var(--texte-doux); }
</style>
