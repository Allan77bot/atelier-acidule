---
// Mes créations — refonte en SCROLL plein écran (scroll-snap vertical).
// Plus de GSAP, plus de flèches, plus de bouton « Découvrir », plus de mode « détail ».
// Une section plein écran par modèle, fond = couleur du modèle, texte blanc lisible.
import Immersif from '../layouts/Immersif.astro';
import { modeles } from '../data/modeles';

const instagram = 'https://www.instagram.com/atelier_acidule';
---

<Immersif titre="Mes créations" fixe>
  <div class="reel" data-reel>
    {modeles.map((m, i) => (
      <section class="creation" style={`--c:${m.couleur}`}>
        <div class="creation__inner">
          <div class="creation__media">
            <img
              class="creation__bag"
              src={m.photo}
              alt={m.nom}
              decoding="async"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="creation__texte">
            <p class="creation__anse">{m.anse}</p>
            <h2 class="creation__nom">{m.nom}</h2>
            <p class="creation__baseline">{m.baseline}</p>
            <p class="creation__prix">dès&nbsp;{m.prix}&nbsp;€</p>
            <p class="creation__desc">{m.description}</p>
            <a
              class="creation__cta"
              href={instagram}
              target="_blank"
              rel="noopener noreferrer"
            >Commander en DM →</a>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Indicateur de scroll : visible sur le 1er écran, disparaît au 1er défilement -->
  <div class="indicateur" data-indicateur aria-hidden="true">
    <span class="indicateur__txt">Défiler</span>
    <span class="indicateur__chevron">↓</span>
  </div>
</Immersif>

<style>
  /* --- Conteneur scrollable interne (le body est figé par la prop `fixe`) --- */
  .reel {
    height: 100dvh;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    overscroll-behavior: contain;
  }

  /* --- Une section plein écran par modèle --- */
  .creation {
    position: relative;
    height: 100dvh;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: var(--c);
    box-sizing: border-box;
  }

  .creation__inner {
    height: 100%;
    box-sizing: border-box;
    max-width: var(--max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: clamp(1.2rem, 4vh, 2.4rem);
    /* haut généreux pour dégager le header fixe (wordmark + burger) */
    padding: clamp(5.5rem, 14vh, 8rem) clamp(1.4rem, 6vw, 3rem) clamp(3rem, 9vh, 5rem);
  }

  /* --- Le sac détouré qui flotte --- */
  .creation__media {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .creation__bag {
    width: auto;
    max-width: min(74vw, 320px);
    max-height: 40vh;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 26px 32px rgba(20, 12, 8, 0.34));
  }

  /* --- Bloc texte (blanc + scrim doux, jamais de rectangle blanc) --- */
  .creation__texte {
    position: relative;
    color: #fff;
    max-width: 44ch;
    z-index: 1;
  }
  /* Scrim translucide foncé, faible opacité, pour garantir le contraste */
  .creation__texte::before {
    content: '';
    position: absolute;
    inset: -1.4rem -1.8rem;
    z-index: -1;
    border-radius: var(--radius-lg);
    background: radial-gradient(
      120% 120% at 50% 45%,
      rgba(0, 0, 0, 0.3),
      rgba(0, 0, 0, 0) 72%
    );
  }

  .creation__anse {
    margin: 0 0 0.6rem;
    font-family: var(--font-corps);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }
  .creation__nom {
    margin: 0 0 0.35rem;
    font-family: var(--font-titre);
    font-weight: 600;
    line-height: 1.04;
    font-size: clamp(2.1rem, 7vw, 3.6rem);
    color: #fff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  .creation__baseline {
    margin: 0 0 0.9rem;
    font-family: var(--font-wordmark);
    font-style: italic;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.32);
  }
  .creation__prix {
    margin: 0 0 1.1rem;
    font-family: var(--font-corps);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.01em;
    color: var(--citron-clair);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }
  .creation__desc {
    margin: 0 0 1.6rem;
    font-family: var(--font-corps);
    line-height: 1.7;
    font-size: clamp(0.98rem, 2.4vw, 1.08rem);
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
  }

  /* CTA discret (lien souligné, pas un gros bouton) */
  .creation__cta {
    display: inline-block;
    font-family: var(--font-corps);
    font-weight: 700;
    font-size: 0.98rem;
    color: #fff;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.55);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .creation__cta:hover,
  .creation__cta:focus-visible {
    border-color: #fff;
    transform: translateX(3px);
  }

  /* --- Indicateur de scroll --- */
  .indicateur {
    position: fixed;
    left: 50%;
    bottom: clamp(1.2rem, 4vh, 2.4rem);
    transform: translateX(-50%);
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    color: #fff;
    mix-blend-mode: difference; /* lisible sur n'importe quelle couleur de panneau */
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .indicateur__txt {
    font-family: var(--font-corps);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.68rem;
    font-weight: 700;
  }
  .indicateur__chevron {
    font-size: 1.2rem;
    line-height: 1;
    animation: rebond 1.6s ease-in-out infinite;
  }
  .indicateur.is-hidden {
    opacity: 0;
  }

  @keyframes rebond {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(7px); }
  }

  /* --- Reveal léger des sections (activé par JS seulement) --- */
  .reel.reveal-on .creation__inner {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reel.reveal-on .creation__inner.is-visible {
    opacity: 1;
    transform: none;
  }

  /* --- Desktop : 2 colonnes alternées (sac / texte) --- */
  @media (min-width: 760px) {
    .creation__inner {
      flex-direction: row;
      text-align: left;
      gap: clamp(2rem, 6vw, 6rem);
    }
    .creation__media,
    .creation__texte {
      flex: 1 1 0;
      min-width: 0;
    }
    .creation__bag {
      max-width: min(38vw, 440px);
      max-height: 72vh;
    }
    /* alternance : sac à droite et texte aligné à droite sur les sections paires */
    .creation:nth-child(even) .creation__inner {
      flex-direction: row-reverse;
    }
    .creation:nth-child(even) .creation__texte {
      text-align: right;
    }
  }

  /* --- Mouvement réduit : on neutralise toute animation --- */
  @media (prefers-reduced-motion: reduce) {
    .reel { scroll-behavior: auto; }
    .indicateur__chevron { animation: none; }
    .reel.reveal-on .creation__inner {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .creation__cta { transition: none; }
  }
</style>

<script>
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const indicateur = document.querySelector<HTMLElement>('[data-indicateur]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // (a) cacher l'indicateur dès le premier défilement (> ~40px)
  if (reel && indicateur) {
    const onScroll = () => {
      if (reel.scrollTop > 40) {
        indicateur.classList.add('is-hidden');
        reel.removeEventListener('scroll', onScroll);
      }
    };
    reel.addEventListener('scroll', onScroll, { passive: true });
  }

  // (b) reveal léger des sections via IntersectionObserver (désactivé si mouvement réduit)
  if (reel && !reduce && 'IntersectionObserver' in window) {
    reel.classList.add('reveal-on');
    const inners = reel.querySelectorAll<HTMLElement>('.creation__inner');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { root: reel, threshold: 0.35 }
    );
    inners.forEach((el) => io.observe(el));
  }
</script>
