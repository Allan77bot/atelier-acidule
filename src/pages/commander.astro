---
// Commander — DA « voeu ». Formulaire on-site placeholder (paiement branché plus tard).
import PageVoeu from '../layouts/PageVoeu.astro';
// La liste vient des familles réellement fabriquées, pas des 3 modèles
// historiques : sinon les boutons « Personnaliser mon porte-verres » du
// catalogue arriveraient ici sans rien présélectionner.
import { familles } from '../data/familles';
const IG = 'https://www.instagram.com/atelier_acidule';
---

<PageVoeu titre="Commander" description="Finalise ta commande de sac au crochet personnalisé — Atelier Acidulé.">
  <section class="cmd">
    <div class="cmd__wrap">
      <header class="cmd__head reveal">
        <p class="eyebrow" style="color:var(--v-jaune-2)">Dernière étape</p>
        <h1 class="display cmd__title">Finalise ta <em>commande.</em></h1>
        <p class="cmd__sous">Le paiement en ligne arrive bientôt. En attendant, laisse-nous tes envies : on confirme la couleur exacte et le délai en DM avant de lancer le crochet.</p>
      </header>

      <form class="cmd__form reveal" data-commande>
        <label>Ton modèle
          <select name="modele" required>
            {familles.map((f) => <option value={f.slug}>{f.nom}</option>)}
          </select>
        </label>
        {/* Référence de la pièce cliquée sur une page famille. Le bloc reste
            masqué tant qu'aucune ?ref= n'est passée : sur une commande
            sur-mesure, il n'y a pas de pièce de départ. */}
        <label class="cmd__ref" data-bloc-ref hidden>Référence de la pièce
          <input type="text" name="reference" data-ref readonly />
          <span class="cmd__refnote">Tu commandes le même modèle que cette photo. <a href="#" data-oublier-ref>Repartir de zéro</a></span>
        </label>

        <label>Couleurs souhaitées (jusqu'à 3)
          <input type="text" name="couleurs" placeholder="ex. citron · sauge · terracotta" />
        </label>
        <label>Type d'anse
          <select name="anse">
            <option value="laine">Anse en laine</option>
            <option value="laiton">Anneaux laiton</option>
          </select>
        </label>
        <label>Pseudo Instagram (pour le suivi)
          <input type="text" name="instagram" placeholder="@toncompte" />
        </label>
        <label>Un mot pour nous (optionnel)
          <textarea name="message" rows="3" placeholder="Une occasion, une idée, une question…"></textarea>
        </label>
        <button type="submit" class="btn-pill btn-pill--jaune">Envoyer ma demande</button>
        <p class="cmd__note" data-statut role="status"></p>
      </form>

      <p class="cmd__alt">Tu préfères discuter de vive voix&nbsp;? <a href={IG} target="_blank" rel="noopener">Écris-nous en DM Instagram</a>.</p>
    </div>
  </section>
</PageVoeu>

<style>
  .cmd { background: var(--v-vert); color: var(--v-creme); padding: clamp(3rem, 6vw, 5rem) clamp(1.1rem, 4vw, 3rem); }
  .cmd__wrap { max-width: 640px; margin-inline: auto; }
  .cmd__head { text-align: center; margin-bottom: 2rem; }
  .cmd__title { color: var(--v-creme); font-size: clamp(2rem, 4.6vw, 3.2rem); margin-bottom: 0.9rem; }
  .cmd__title em { font-style: normal; color: var(--v-jaune); }
  .cmd__sous { color: rgba(245,239,224,.8); }

  .cmd__form { display: grid; gap: 1.1rem; background: var(--v-creme); padding: 2rem; border-radius: 20px; }
  .cmd__form label { display: grid; gap: 0.4rem; font-family: 'Archivo', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.75rem; color: var(--v-encre); }
  .cmd__form input, .cmd__form select, .cmd__form textarea { font-family: var(--font-corps); font-weight: 400; text-transform: none; letter-spacing: normal; font-size: 1rem; padding: 0.7rem 0.9rem; border-radius: 12px; border: 1.5px solid rgba(43,42,34,.2); background: #fff; color: var(--v-encre); }
  .cmd__form input:focus, .cmd__form select:focus, .cmd__form textarea:focus { border-color: var(--v-jaune-2); outline: none; }
  .cmd__form button { justify-self: start; margin-top: 0.3rem; }
  .cmd__ref input { background: var(--v-creme-2); font-family: 'Archivo', sans-serif; font-weight: 700; letter-spacing: 0.06em; }
  .cmd__refnote { font-family: var(--font-corps); font-weight: 400; text-transform: none; letter-spacing: normal; font-size: 0.78rem; color: var(--v-doux); }
  .cmd__refnote a { color: var(--v-encre); }
  .cmd__note { margin: 0; font-weight: 700; color: var(--olive); min-height: 1.2em; }
  .cmd__alt { text-align: center; margin-top: 1.5rem; color: rgba(245,239,224,.8); }
  .cmd__alt a { color: var(--v-jaune); text-decoration: underline; }

  @media (max-width: 560px) {
    .cmd__form { padding: 1.4rem; }
    .cmd__form input, .cmd__form select, .cmd__form textarea { font-size: 16px; }
    .cmd__form button { width: 100%; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-commande]');
  const statut = document.querySelector<HTMLElement>('[data-statut]');

  const params = new URLSearchParams(location.search);

  // Présélectionne le modèle si on arrive via /commander?modele=<slug>
  // (les CTA de l'accueil et des pages /creations passent ce paramètre).
  const slug = params.get('modele');
  const select = form?.querySelector<HTMLSelectElement>('select[name="modele"]');
  if (slug && select?.querySelector(`option[value="${slug}"]`)) select.value = slug;

  // Référence de la pièce, passée par « Commander cette pièce ».
  const bloc = document.querySelector<HTMLElement>('[data-bloc-ref]');
  const champ = document.querySelector<HTMLInputElement>('[data-ref]');
  const ref = params.get('ref');
  // On n'accepte que le format attendu : une ?ref= arbitraire finirait
  // telle quelle dans la demande envoyée à Marine.
  if (bloc && champ && ref && /^[A-Z0-9-]{3,40}$/.test(ref)) {
    champ.value = ref;
    bloc.hidden = false;
  }

  document.querySelector('[data-oublier-ref]')?.addEventListener('click', (e) => {
    e.preventDefault();
    if (champ) champ.value = '';
    if (bloc) bloc.hidden = true;
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (statut) statut.textContent = 'Merci ! 🍋 Demande enregistrée — on te confirme tout en DM Instagram très vite.';
    form.reset();
  });
</script>
