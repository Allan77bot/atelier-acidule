---
import '../styles/global.css';
import '../styles/polish.css'; // couche de finition premium, chargée après global
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titre: string;
  description?: string;
}

const {
  titre,
  description = 'Sacs et accessoires au crochet faits main à la demande — Atelier Acidulé. Des créations qui ne manquent pas de piquant.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{titre} · Atelier Acidulé</title>
    <meta name="description" content={description} />

    <!-- Polices : Playfair Display (wordmark/CTA), Fraunces (titres), Nunito Sans (corps) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Nunito+Sans:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,500..700;1,500..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
